// DropdownMenu (specs/phase02/components.md): a popover anchored to its
// trigger. Links or actions decide its semantics and its JS, at compile time.
import type { ReactNode } from "react";
import { Each, isAssigned, mount, slotEntry, slotKeys, useShellId, variants, type KeyedSlot, type Slot } from "@reactogenic/core";
import { Button, type Command, type TriggerProps } from "./button.rtsx";
import "./tokens.css";
import "./dropdown-menu.css";

// An item is a link, or a declarative action on another element: one or the
// other. Named member by member, so that a type error says which case the
// author wrote.

/** What both kinds of item have. */
interface MenuItemCommonProps {
  /** The item that stands for what is shown now (the current version). */
  current?: boolean;
  /** Neither focus nor the arrow keys stop at it; a link is emitted without its `href`. */
  disabled?: boolean;
  children?: ReactNode;
}

/** An item that is a link. A link commands nothing. */
export interface MenuLinkProps extends MenuItemCommonProps {
  href: string;
  command?: undefined;
  commandfor?: undefined;
}

/** An item that is an action: a command on the dialog `commandfor` names. */
export interface MenuActionProps extends MenuItemCommonProps {
  href?: undefined;
  command?: Command;
  commandfor?: string;
}

export type MenuItemProps = MenuLinkProps | MenuActionProps;

export interface DropdownMenuProps {
  id?: string;
  /** Option: the edge of the trigger the menu lines up with. Default "start". */
  align?: "start" | "end";
  /** Option, action menus only: a printable key moves to the next item that starts with it. */
  typeahead?: boolean;
  $Trigger: Slot<TriggerProps>;
  /** In the order written. */
  $Item: KeyedSlot<MenuItemProps>;
}

type ItemProps = MenuItemProps & {
  role?: "menuitem";
  autoFocus?: boolean;
};

function MenuItem({ href, current, children, ...rest }: ItemProps) {
  const ariaCurrent = current ? "true" : undefined;
  if (href !== undefined) {
    // A disabled link is HTML's placeholder link — `<a>` without `href`: not
    // focusable, not a link — and says so to assistive technology.
    if (rest.disabled) {
      return <a role={rest.role} aria-disabled="true" aria-current={ariaCurrent}>{children}</a>;
    }
    return <a href role={rest.role} aria-current={ariaCurrent} autoFocus={rest.autoFocus}>{children}</a>;
  }
  return <button type="button" {...rest} aria-current={ariaCurrent}>{children}</button>;
}

// An option a rule selects resolves into one class (components.md, *CSS
// convention*); the default has none.
const menuVariants = { align: { start: "", end: "rg-menu-end" } } as const;

export function DropdownMenu({ id, align, typeahead, $Trigger, $Item }: DropdownMenuProps) {
  const generated = useShellId("m");
  const menu = id ?? generated;
  // The items as written: `slotKeys`, never `Object.keys` — an entry's
  // property name is its key encoded (phase01/syntax.md, *Keyed slots*).
  const keys = slotKeys($Item);
  const item = (key: string) => slotEntry($Item, key)!;
  const className = variants("rg-menu", menuVariants, { align });
  // Back must not restore the page with the menu open.
  mount("@reactogenic/ui/behaviors/overlays");
  // Every item a link: a disclosure of links. A list, no `menu` role, Tab
  // moves through it, no JS (APG keeps navigation out of role="menu").
  if (keys.every((key) => item(key).href !== undefined)) {
    return (
      <>
        <Button slot={$Trigger} popoverTarget={menu} />
        <ul id={menu} className popover="">
          <Each items={keys} { item: key }>
            <li key={key}><MenuItem key={key} slot={$Item} /></li>
          </Each>
        </ul>
      </>
    );
  }
  // An action item: role="menu", which promises arrow keys — so this menu
  // mounts them. The trigger names the menu — by the author's `id` when the
  // slot has one: a slot's props replace the attachment's. Focus enters at
  // the first item that can take it.
  const trigger = (isAssigned($Trigger) ? $Trigger.id : undefined) ?? menu + "-t";
  const first = keys.find((key) => !item(key).disabled);
  // The flag is the page's — the union of its mounts: it says whether the
  // typeahead code is in the page's script. That this menu uses it is the
  // mount's data: only the behaviour reads it, so it is an argument of this
  // menu's call, not an attribute (builder.md, *Behaviours*).
  mount("@reactogenic/ui/behaviors/menu-keys", menu, { RG_MENU_TYPEAHEAD: typeahead === true }, typeahead ? { typeahead: true } : undefined);
  if (keys.some((key) => item(key).href === undefined && item(key).command !== undefined)) {
    mount("@reactogenic/ui/behaviors/invokers");
  }
  return (
    <>
      <Button slot={$Trigger} id={trigger} popoverTarget={menu} aria-haspopup="menu" />
      <div id={menu} className popover="" role="menu" aria-labelledby={trigger}>
        <Each items={keys} { item: key }>
          <MenuItem key={key} slot={$Item} role="menuitem" autoFocus={key === first} />
        </Each>
      </div>
    </>
  );
}
