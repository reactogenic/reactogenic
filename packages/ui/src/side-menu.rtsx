// SideMenu (specs/phase02/components.md): one `<nav popover>` — a column
// above the breakpoint, a drawer in the top layer below it. The current page
// is the builder's: the item whose `href` is the page being rendered.
import type { ComponentProps, ReactNode } from "react";
import { Each, mount, pathname, useShellId, type KeyedSlot, type Slot } from "@reactogenic/core";
import "./tokens.css";
import "./side-menu.css";

/** A link, or — with nested `$Item`s and no `href` — a disclosure of them. */
export interface SideMenuItemProps {
  href?: string;
  /** The label. */
  children?: ReactNode;
  $Item?: KeyedSlot<SideMenuItemProps>;
}

/** A group of items, titled or not. */
export interface SideMenuSectionProps {
  title?: string;
  /** Option: absent = not collapsible; `false` = collapsible, open. */
  collapsed?: boolean;
  $Item: KeyedSlot<SideMenuItemProps>;
}

export interface SideMenuProps {
  id?: string;
  /** The landmark's name. */
  label: string;
  $Header?: Slot<ComponentProps<"div">>;
  $Section: KeyedSlot<SideMenuSectionProps>;
  $Footer?: Slot<ComponentProps<"div">>;
  /** The drawer's button; the fallback is the menu icon. */
  $Toggle?: Slot<ComponentProps<"button">>;
}

// `/guide` and `/guide/` are one page.
function page(path: string): string {
  return path.endsWith("/") ? path : path + "/";
}

function isCurrent(href: string | undefined): boolean {
  return href !== undefined && page(href) === page(pathname());
}

// Is the current page among the items, at any depth?
function holdsCurrent(items: KeyedSlot<SideMenuItemProps>): boolean {
  return Object.values(items).some((item) => (item.$Item !== undefined ? holdsCurrent(item.$Item) : isCurrent(item.href)));
}

function Items({ $Item }: { $Item: KeyedSlot<SideMenuItemProps> }) {
  return (
    <ul>
      <Each items={Object.keys($Item)} { item: key }>
        <Item key={key} slot={$Item} />
      </Each>
    </ul>
  );
}

function Item({ href, children, $Item }: SideMenuItemProps) {
  if ($Item !== undefined) {
    // Every disclosure around the current page is open.
    const open = holdsCurrent($Item);
    return (
      <li>
        <details open>
          <summary>{children}</summary>
          <Items $Item={$Item} />
        </details>
      </li>
    );
  }
  return (
    <li>
      <a href aria-current={isCurrent(href) ? "page" : undefined}>{children}</a>
    </li>
  );
}

// An attachment on a component always passes `children`, so the section accepts it.
function Section({ title, collapsed, $Item }: SideMenuSectionProps & { children?: ReactNode }) {
  if (collapsed !== undefined) {
    const open = !collapsed || holdsCurrent($Item);
    return (
      <details open>
        <summary>{title}</summary>
        <Items $Item={$Item} />
      </details>
    );
  }
  return (
    <section>
      {title !== undefined ? <h2>{title}</h2> : null}
      <Items $Item={$Item} />
    </section>
  );
}

export function SideMenu({ id, label, $Header, $Section, $Footer, $Toggle }: SideMenuProps) {
  const generated = useShellId("s");
  const menu = id ?? generated;
  // The drawer is a popover: Back must not restore the page with it open.
  mount("@reactogenic/ui/behaviors/overlays");
  return (
    <>
      <button slot={$Toggle} type="button" className="rg-sidemenu-toggle" popoverTarget={menu} aria-label={label}>☰</button>
      <nav id={menu} className="rg-sidemenu" popover="" aria-label={label}>
        {/* Always there: on iOS 17–18.2 a popover does not close on an outside tap. */}
        <button type="button" data-part="close" popoverTarget={menu} popoverTargetAction="hide" aria-label="Close">✕</button>
        <div slot={$Header} data-part="header" />
        <Each items={Object.keys($Section)} { item: key }>
          <Section key={key} slot={$Section} />
        </Each>
        <div slot={$Footer} data-part="footer" />
        {/* The drawer's own backdrop: a popover's `::backdrop` lets a tap
            through, and closing on the way hands the click to what is behind.
            This one is inside the popover, over the rest of the viewport. */}
        <button type="button" data-part="scrim" popoverTarget={menu} popoverTargetAction="hide" tabIndex={-1} aria-hidden="true" />
      </nav>
    </>
  );
}
