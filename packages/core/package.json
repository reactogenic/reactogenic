{
  "name": "@reactogenic/core",
  "version": "0.1.0-alpha.1",
  "description": "Runtime of Reactogenic's .rtsx: slots, Match / Switch, Each.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactogenic/reactogenic.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/reactogenic/reactogenic#readme",
  "bugs": "https://github.com/reactogenic/reactogenic/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts.mjs dist"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!dist/**/*.check.*",
    "!src/**/*.test.*",
    "!src/**/*.check.*"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
