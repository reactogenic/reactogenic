{
  "name": "@reactogenic/vite",
  "version": "0.1.0-alpha.0",
  "description": "Vite plugin for Reactogenic's .rtsx files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactogenic/reactogenic.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/reactogenic/reactogenic#readme",
  "bugs": "https://github.com/reactogenic/reactogenic/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts.mjs dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "dependencies": {
    "@reactogenic/cli": "workspace:*"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
