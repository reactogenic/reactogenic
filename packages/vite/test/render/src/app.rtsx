import type { ReactNode } from "react";
import { Each, Match, Switch, type KeyedSlot, type Slot } from "@reactogenic/core";

// A container: three attachments — plain with fallback, function slot with
// args, and a slot attached once per option.
interface ListProps {
  options: { value: string; label: string }[];
  selected: string;
  $Title?: Slot<{ className?: string; children?: ReactNode }>;
  $Option?: Slot<{ className?: string }, { label: string; selected: boolean }>;
}

function List({ options, selected, $Title, $Option }: ListProps) {
  return (
    <section>
      <h1 slot={$Title} className="default">Untitled</h1>
      <ul>
        <Each items={options} { item: option }>
          <li key={option.value} slot={$Option} &&className={option.value} &label={option.label} &selected={option.value === selected}>
            {option.label}
          </li>
        </Each>
      </ul>
    </section>
  );
}

const options = [
  { value: "a", label: "Alpha" },
  { value: "b", label: "Beta" },
];

export function WithSlots({ mode }: { mode: "loading" | "ready" }) {
  const selected = "b";
  return (
    <main>
      <List options selected>
        <$Title className="custom">Picked</$Title>
        <$Option { label, selected }>
          {label}
          <Match on={selected}>!</Match>
        </$Option>
      </List>
      <Switch on={mode}>
        <$Case is="loading">Loading</$Case>
        <$Case is="ready">Ready</$Case>
      </Switch>
      <section #intro />
    </main>
  );
}

export function WithoutSlots() {
  return <List options={options} selected="a" />;
}

// A keyed slot: entries by key, attached by the key of each column.
interface TableProps {
  columns: { name: string; label: string }[];
  $Column?: KeyedSlot<{ className?: string; children?: ReactNode }>;
}

function Table({ columns, $Column }: TableProps) {
  return (
    <tr>
      <Each items={columns} { item: col }>
        <th key={col.name} slot={$Column}>{col.label}</th>
      </Each>
    </tr>
  );
}

export function Columns() {
  const columns = [
    { name: "email", label: "E-mail" },
    { name: "name", label: "Name" },
    { name: "age", label: "Age" },
  ];
  return (
    <Table columns>
      <$Column key="email" className="wide">Mail</$Column>
      <$Column key="age" />
    </Table>
  );
}
