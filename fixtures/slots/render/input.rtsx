export function Select({ options, $Option, selected }: any) {
  return (
    <select>
      <Each items={options} { item: option }>
        <option key={option.value} slot={$Option} className="opt" &&value={option.value} &label={option.label} &&selected={selected === option.value}>
          {option.label}
        </option>
      </Each>
    </select>
  );
}
export const d = <i slot={props.$Icon} &&size &count={n + 1} />;
export const e = <div slot="header" />;
