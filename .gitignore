node_modules/
# every build output: the packages', and what `reactogenic build` writes
# (site/dist; `--out` defaults to `dist` next to the tsconfig)
dist/
coverage/
*.log
.DS_Store
/go/bin/
/dist/

# copied from the root by scripts/release.sh
packages/*/LICENSE

# VS Code downloaded by the editor suite (packages/vscode, pnpm test:editor)
.vscode-test/

# release tokens (scripts/release.sh publish-vsix): never committed
.env.release

# written by the tests of packages/ui: the spec's examples, the stand-in build
packages/ui/.examples/
