// "/dialog/": a dialog with its trigger: `overlays` and `invokers`.
import { Dialog } from "@reactogenic/ui";
import { Layout } from "../../layout.rtsx";

export default function DialogPage() {
  return (
    <Layout title="Dialog">
      <h1>Dialog</h1>
      <Dialog id="install">
        <$Trigger>Install</$Trigger>
        <$Title>Install</$Title>
        <pre>pnpm add @reactogenic/core@alpha</pre>
        <$Action key="ok">Got it</$Action>
      </Dialog>
    </Layout>
  );
}
