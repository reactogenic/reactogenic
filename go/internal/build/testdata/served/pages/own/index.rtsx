// "/own/": a script of the page's own, beside the builder's — the page
// mounts a behaviour too. What the author's script writes is not known: the
// page is not pruned. The builder's `<script>` alone leaves "/" pruned.
import { mount } from "@reactogenic/core";
import { Layout } from "../../layout.tsx";

function Marked() {
  mount("./behaviors/mark", "marked");
  return <p id="marked">Marked.</p>;
}

export default function OwnPage() {
  return (
    <Layout title="Own">
      <Marked />
      <script dangerouslySetInnerHTML={{ __html: `document.documentElement.classList.add("never")` }} />
    </Layout>
  );
}
