// Avatar: a person — a picture, or the initials of the name. A fixture
// (bench/catalog/README.md).
import { variants } from "@reactogenic/core";
import "@reactogenic/ui/tokens.css";
import "./tokens.css";
import "./avatar.css";

export interface AvatarProps {
  /** The person: the accessible name, and where the initials come from. */
  name: string;
  /** A picture; without one, the initials. */
  src?: string;
  /** Option: a class of its own per value. Default "md". */
  size?: "sm" | "md" | "lg";
  /** Option: a class of its own per value. Default "circle". */
  shape?: "circle" | "square";
}

// "Ada Lovelace" → "AL"; one word → its first two letters.
function initials(name: string): string {
  const words = name.trim().split(/\s+/);
  const letters = words.length > 1 ? words[0]![0]! + words.at(-1)![0]! : words[0]!.slice(0, 2);
  return letters.toUpperCase();
}

// Options a rule selects: one class per value, unique to it; the default has
// none (specs/phase02/components.md, *CSS convention*).
const avatarVariants = {
  size: { sm: "bc-avatar-sm", md: "", lg: "bc-avatar-lg" },
  shape: { circle: "", square: "bc-avatar-square" },
} as const;

export function Avatar({ name, src, size, shape }: AvatarProps) {
  return (
    <span className={variants("bc-avatar", avatarVariants, { size, shape })} role="img" aria-label={name}>
      {src !== undefined ? <img src alt="" /> : <span data-part="initials" aria-hidden="true">{initials(name)}</span>}
    </span>
  );
}
