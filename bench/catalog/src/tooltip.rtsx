// Tooltip: a short description of what it wraps, shown on hover and on
// keyboard focus. CSS only: `popover="hint"` with `interestfor` is Chromium's
// alone, below the floor of specs/phase02/decisions.md (11), and a tooltip
// that needs a script is a behaviour per use site. The price: Esc does not
// dismiss it (WCAG 1.4.13) — a limit of this fixture
// (bench/catalog/README.md).
import type { ReactNode } from "react";
import { useShellId } from "@reactogenic/core";
import "@reactogenic/ui/tokens.css";
import "./tokens.css";
import "./tooltip.css";

export interface TooltipProps {
  /** The description. */
  text: string;
  /** Option: `data-side`. Default "top". */
  side?: "top" | "bottom";
  /** What is described: a word, an abbreviation. It gets a tab stop. */
  children?: ReactNode;
}

export function Tooltip({ text, side, children }: TooltipProps) {
  const id = useShellId("tt");
  return (
    <span className="bc-tooltip" data-side={side === "bottom" ? side : undefined}>
      <span data-part="trigger" tabIndex={0} aria-describedby={id}>{children}</span>
      <span role="tooltip" id>{text}</span>
    </span>
  );
}
