// Toast: a message that comes and goes. A manual popover — the platform
// shows and hides it, in the top layer — which its `$Trigger` shows; the
// `toast` behaviour hides it again after `timeout`. A fixture
// (bench/catalog/README.md): on a static page nothing but a button can say
// "show it", so the trigger stands for what a form's handler would do.
import type { ReactNode } from "react";
import { mount, useShellId, type Slot } from "@reactogenic/core";
import { Button, type TriggerProps } from "@reactogenic/ui";
import "@reactogenic/ui/tokens.css";
import "./tokens.css";
import "./toast.css";

export interface ToastProps {
  id?: string;
  /** Option: `data-tone`. Default "neutral". */
  tone?: "neutral" | "success" | "danger";
  /** Milliseconds until it hides itself; 0 keeps it until it is dismissed. Default 4000. */
  timeout?: number;
  /** The button that shows it. */
  $Trigger: Slot<TriggerProps>;
  /** The message. */
  children?: ReactNode;
}

export function Toast({ id, tone, timeout = 4000, $Trigger, children }: ToastProps) {
  const generated = useShellId("toast");
  const toast = id ?? generated;
  // A popover: Back must not restore the page with it shown.
  mount("@reactogenic/ui/behaviors/overlays");
  if (timeout > 0) {
    mount("@reactogenic/bench-catalog/behaviors/toast", toast, undefined, { timeout });
  }
  return (
    <>
      <Button slot={$Trigger} popoverTarget={toast} popoverTargetAction="show" />
      <div id={toast} className="bc-toast" popover="manual" role="status" data-tone={tone === "neutral" ? undefined : tone}>
        <div data-part="body">{children}</div>
        <button type="button" data-part="close" popoverTarget={toast} popoverTargetAction="hide" aria-label="Dismiss">✕</button>
      </div>
    </>
  );
}
