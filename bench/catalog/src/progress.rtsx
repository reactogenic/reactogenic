// Progress: the platform's `<progress>`, labelled, with its value in text.
// Without a value it is indeterminate, and moves. No JS. A fixture
// (bench/catalog/README.md).
import { useShellId, variants } from "@reactogenic/core";
import "@reactogenic/ui/tokens.css";
import "./tokens.css";
import "./progress.css";

export interface ProgressProps {
  label: string;
  /** 0…`max`; absent = indeterminate. */
  value?: number;
  /** Default 100. */
  max?: number;
  /** The value as the reader should see it: "6.2 of 10 GB". Default: a percentage. */
  text?: string;
  /** Option: a class of its own per value. Default "accent". */
  tone?: "accent" | "success" | "warning" | "danger";
  /** Option: a class of its own per value. Default "md". */
  size?: "md" | "sm";
}

// Options a rule selects: one class per value, unique to it; the default has
// none (specs/phase02/components.md, *CSS convention*).
const progressVariants = {
  tone: { accent: "", success: "bc-progress-success", warning: "bc-progress-warning", danger: "bc-progress-danger" },
  size: { md: "", sm: "bc-progress-sm" },
} as const;

export function Progress({ label, value, max = 100, text, tone, size }: ProgressProps) {
  const id = useShellId("p");
  const shown = text ?? (value !== undefined ? `${Math.round((value / max) * 100)}%` : undefined);
  return (
    <div className={variants("bc-progress", progressVariants, { tone, size })}>
      <div data-part="header">
        <label htmlFor={id}>{label}</label>
        {shown !== undefined ? <span data-part="value">{shown}</span> : null}
      </div>
      <progress id value max>{shown}</progress>
    </div>
  );
}
