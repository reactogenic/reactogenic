// Table: rows of data, static. Its cells are the page's data, by column
// key; it scrolls sideways in its own box. A fixture
// (bench/catalog/README.md).
import type { ReactNode } from "react";
import { Each, slotEntry, slotKeys, variants, type KeyedSlot } from "@reactogenic/core";
import "@reactogenic/ui/tokens.css";
import "./tokens.css";
import "./table.css";

export interface TableColumnProps {
  /** Option: a class of its own per value on the column's cells. Default "start". */
  align?: "start" | "end";
  /** The header. */
  children?: ReactNode;
}

export interface TableProps {
  /** The table's name: its `<caption>`, and the scrolling region's label. */
  caption: string;
  /** Option: a class of its own per value. Default "comfortable". */
  density?: "comfortable" | "compact";
  /** Option: every other row is tinted. */
  striped?: boolean;
  /** Option: the header row stays while the page scrolls. */
  sticky?: boolean;
  /** The column whose cells are the rows' headers (`<th scope="row">`). */
  rowHeader?: string;
  /** In order. A column's key names its cells in `rows`. */
  $Column: KeyedSlot<TableColumnProps>;
  /** A row: its cells by column key. */
  rows: readonly Readonly<Record<string, ReactNode>>[];
}

// Options a rule selects: one class per value, unique to it; the default has
// none (specs/phase02/components.md, *CSS convention*).
const tableVariants = {
  density: { comfortable: "", compact: "bc-table-compact" },
  striped: { on: "bc-table-striped" },
  sticky: { on: "bc-table-sticky" },
} as const;
// A column's option is on its cells, which have no class but this one.
const cellVariants = { align: { start: "", end: "bc-table-end" } } as const;
const cell = (align: TableColumnProps["align"]) => variants("", cellVariants, { align }) || undefined;

function Head({ align, children }: TableColumnProps) {
  return <th scope="col" className={cell(align)}>{children}</th>;
}

export function Table({ caption, density, striped, sticky, rowHeader, $Column, rows }: TableProps) {
  const keys = slotKeys($Column);
  return (
    // A box that scrolls must be reachable by keyboard: a named region with a tab stop.
    <div
      className={variants("bc-table", tableVariants, { density, striped: striped ? "on" : undefined, sticky: sticky ? "on" : undefined })}
      role="region"
      aria-label={caption}
      tabIndex={0}
    >
      <table>
        <caption>{caption}</caption>
        <thead>
          <tr>
            <Each items={keys} { item: key }>
              <Head key={key} slot={$Column} />
            </Each>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, index) => (
            <tr key={index}>
              {keys.map((key) => {
                const className = cell(slotEntry($Column, key)!.align);
                return key === rowHeader ? (
                  <th key={key} scope="row" className>{row[key]}</th>
                ) : (
                  <td key={key} className>{row[key]}</td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
